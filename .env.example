WIDGETBOT_CHANNEL_2=355719584830980097
WIDGETBOT_COLOR=#5865f2
# WidgetBot shard (embed backend URL).
# Leave empty for free tier (https://e.widgetbot.io).
# Business tier: https://e-business.widgetbot.co
WIDGETBOT_SHARD=

# Discord Bot Integration
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_WEBHOOK_URL=
# Guild ID for slash command registration (leave empty for global commands)
DISCORD_GUILD_ID=

# Interactions endpoint URL override (e.g. your deployed domain).
# Leave empty to use ngrok auto-detection.
INTERACTIONS_URL=

# Gemini AI
GEMINI_API_KEY=
# Model for text generation (default: gemini-2.0-flash)
GEMINI_MODEL=
# Separate key/model for image generation (falls back to GEMINI_API_KEY if unset)
GEMINI_IMAGE_API_KEY=
GEMINI_IMAGE_MODEL=
# Set to "false" to disable Google Search grounding (default: true)
GEMINI_SEARCH_GROUNDING=

# Private AI Threads (optional)
# Set to a text channel ID to enable per-user private threads for /ai, /ask, /gen.
# Bot needs CREATE_PRIVATE_THREADS + SEND_MESSAGES_IN_THREADS + MANAGE_THREADS.
AI_THREAD_PARENT_CHANNEL=